#!/bin/sh
# Bring every Hyprland output back on after an idle blank or a suspend.
#
# WHAT HYPRLAND 0.56 ACTUALLY GIVES US (measured on minerva 2026-09-02, not
# inferred): `hl.dsp.dpms()` is a pure TOGGLE, and it ignores both its state
# argument and its monitor argument. `dpms("on")`, `dpms("off")`,
# `dpms("toggle")` and `dpms("on", "DP-5")` all do the same thing: flip the
# DPMS state of every output. There is no way to assert "on", and no way to
# address a single output.
#
# Two consequences drive everything below.
#
# 1. A blanket toggle only helps when every output is already off, which is
#    the normal case after hypridle blanks them. Then one toggle lights them
#    all and we are done.
#
# 2. Outputs can drift ANTI-PHASE — some on, some off. A toggle then just
#    swaps which ones are dark, forever. That is the flip-flopping this script
#    used to cause by retrying "on" per monitor in a loop. So a mixed state is
#    a hard stop, not something to retry: it needs connector hotplug (flip the
#    KVM away and back), which is the only thing observed to resync it.
#
# Deliberately NOT here: `hl.monitor({ disabled = true })` as a recovery step.
# It releases the CRTC, and neither a reload, a re-declare, nor any dpms call
# gets it back — the output stays dark until a physical hotplug. Reaching for
# it turns a blank screen into a stuck one.
#
# Used by hypridle's on-resume/after_sleep_cmd, by hypr-monitor-repaint, and
# by the SUPER+SHIFT+D keybind.

set -u

tries=5
delay=1

die() {
    echo "hypr-dpms-wake: $*" >&2
    exit 1
}

command -v jq >/dev/null 2>&1 || die "jq not found"

# Reading monitor state MUST fail loudly. An earlier version let a failed
# hyprctl fall through as "nothing is off" and exited 0, so a dead IPC socket
# looked exactly like a successful wake.
monitors() {
    json=$(hyprctl monitors -j 2>/dev/null) || return 1
    printf '%s' "$json" | jq -e 'type == "array" and length > 0' >/dev/null 2>&1 || return 1
    printf '%s' "$json"
}

names_off() {
    printf '%s' "$1" | jq -r '.[] | select(.dpmsStatus == false) | .name'
}

names_on() {
    printf '%s' "$1" | jq -r '.[] | select(.dpmsStatus == true) | .name'
}

oneline() {
    echo "$1" | tr '\n' ' ' | sed 's/ *$//'
}

n=0
while [ "$n" -le "$tries" ]; do
    json=$(monitors) || die "cannot read monitor state (is Hyprland running?)"
    off=$(names_off "$json")

    # Everything is on: done.
    [ -n "$off" ] || exit 0

    on=$(names_on "$json")
    if [ -n "$on" ]; then
        die "outputs are anti-phase, toggling would only swap which ones are dark.
  on:  $(oneline "$on")
  off: $(oneline "$off")
  Fix: flip the KVM away and back (connector hotplug resyncs them)."
    fi

    # Everything is off: one toggle lights the lot.
    hyprctl dispatch 'hl.dsp.dpms("on")' >/dev/null
    n=$(( n + 1 ))
    sleep "$delay"
done

json=$(monitors) || die "cannot read monitor state (is Hyprland running?)"
off=$(names_off "$json")
[ -n "$off" ] || exit 0
die "still off after $tries toggles: $(oneline "$off")"
