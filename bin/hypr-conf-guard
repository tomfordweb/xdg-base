#!/bin/sh
# Restore config/hypr/hyprland.lua when Hyprland clobbers it with its
# autogenerated stub.
#
# Hyprland writes a default stub (marked `hl.config({ autogenerated = true })`)
# whenever it launches and ~/.config/hypr/hyprland.lua doesn't resolve — e.g.
# the brief window while home-manager swaps symlinks during a rebuild.
# Because ~/.config/hypr is a live symlink into this repo, the stub lands in
# the working tree, wiping the real config (and with it every autostart and
# bind, so nothing self-heals from inside the session). A systemd user path
# unit (nixos/home/dotfiles.nix) watches the file and runs this script, which
# restores from git and reloads.
#
# Since 0.56 Hyprland reads ONLY hyprland.lua — there is no hyprland.conf
# fallback, so this guard follows the Lua file.

set -u

repo="$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)"
conf="config/hypr/hyprland.lua"

grep -q 'autogenerated = true' "$repo/$conf" 2>/dev/null || exit 0

# If HEAD itself somehow held the stub, checkout would loop forever.
git -C "$repo" show "HEAD:$conf" 2>/dev/null | grep -q 'autogenerated = true' && exit 0

git -C "$repo" checkout -- "$conf" || exit 1

# hyprctl needs the instance signature; systemd units don't inherit it,
# so fall back to the most recent instance dir.
if [ -z "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]; then
  # shellcheck disable=SC2012  # instance sigs are hex names; newest-first is
  # the whole point and find has no ordering without sort plumbing.
  HYPRLAND_INSTANCE_SIGNATURE="$(ls -t "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/hypr" 2>/dev/null | head -n 1)"
  export HYPRLAND_INSTANCE_SIGNATURE
fi
if [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ] && command -v hyprctl >/dev/null 2>&1; then
  hyprctl reload >/dev/null 2>&1 || true
fi
